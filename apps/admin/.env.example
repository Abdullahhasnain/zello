# --- Clerk (internal ops auth — SSO + mandatory MFA enforced in Clerk dashboard) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx
# For Auth0 instead of Clerk, use the same Auth0 Web Application and API
# audience as the dashboard, but a different APP_BASE_URL and AUTH0_SECRET.
# AUTH_PROVIDER=auth0
# AUTH0_DOMAIN=YOUR-TENANT.us.auth0.com
# AUTH0_CLIENT_ID=YOUR-CLIENT-ID
# AUTH0_CLIENT_SECRET=YOUR-CLIENT-SECRET
# AUTH0_SECRET=GENERATE-A-RANDOM-32-BYTE-HEX-SECRET
# AUTH0_AUDIENCE=urn:zello-ai:api
# APP_BASE_URL=http://localhost:3001
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# --- Backend API ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Access restriction (see docs/architecture/auth-flow.md) ---
ADMIN_ALLOWED_IP_RANGES=127.0.0.1/32
