# --- Clerk (store owner auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx
# For Auth0 instead of Clerk: set AUTH_PROVIDER=auth0 and configure the
# Auth0 Regular Web Application's callback URL to APP_BASE_URL/auth/callback.
# AUTH_PROVIDER=auth0
# AUTH0_DOMAIN=YOUR-TENANT.us.auth0.com
# AUTH0_CLIENT_ID=YOUR-CLIENT-ID
# AUTH0_CLIENT_SECRET=YOUR-CLIENT-SECRET
# AUTH0_SECRET=GENERATE-A-RANDOM-32-BYTE-HEX-SECRET
# AUTH0_AUDIENCE=urn:zello-ai:api
# APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# --- Backend API ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Must match the backend's INTERNAL_SERVICE_TOKEN — used only by the Clerk
# webhook route (api/webhooks/clerk/route.ts) to forward user.created events.
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-secret

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
