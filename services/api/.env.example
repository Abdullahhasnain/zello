# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database (pgvector extension required — see db/ddl/001_extensions.sql) ---
# Privileged (BYPASSRLS) role — admin cross-tenant ops + pre-tenant identity
# lookups only. See db/ddl/003_row_level_security.sql.
DATABASE_URL=postgresql+asyncpg://zello_admin:zello_admin@localhost:5432/zello_ai
# RLS-enforced role — every query touching a specific tenant's data goes
# through this connection instead. Never grant this role BYPASSRLS.
DATABASE_URL_APP=postgresql+asyncpg://zello_app:zello_app@localhost:5432/zello_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth: Clerk (store owner / admin) ---
# Set AUTH_PROVIDER=auth0 to use hosted Auth0 login on a shared Railway domain.
# Clerk remains the default for installations with an owned production domain.
AUTH_PROVIDER=clerk
CLERK_JWKS_URL=https://YOUR-CLERK-DOMAIN.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://YOUR-CLERK-DOMAIN.clerk.accounts.dev
# Auth0 values are only required when AUTH_PROVIDER=auth0.
# AUTH0_DOMAIN=YOUR-TENANT.us.auth0.com
# AUTH0_AUDIENCE=urn:zello-ai:api

# --- Internal service-to-service calls (e.g. the dashboard's Clerk webhook
# route forwarding a user.created event to POST /users/internal/clerk-sync) ---
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-secret

# --- Auth: internal JWT (guest/OTP customer widget sessions) ---
CUSTOMER_JWT_SECRET=replace-with-a-long-random-secret
CUSTOMER_JWT_ALGORITHM=HS256
CUSTOMER_JWT_ACCESS_TTL_MINUTES=60
CUSTOMER_JWT_REFRESH_TTL_DAYS=14

# --- Partner integrations ---
PARTNER_API_HMAC_SECRET=replace-with-a-long-random-secret

# --- AI: embeddings for semantic product search (FR-4.3) ---
# Required even if you're running AI_PROVIDER=gemini below (Settings can't
# conditionally require a field) — leave this placeholder as-is in that case.
OPENAI_API_KEY=sk-replace-with-a-real-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SEARCH_DEFAULT_TOP_K=10

# --- AI: Gemini — a free alternative to OpenAI for both chat and embeddings.
# Get a key at https://aistudio.google.com/apikey (no billing/credit card
# required for the free tier). Set AI_PROVIDER=gemini below to use it. ---
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- AI: conversational shopping assistant (Conversation Orchestrator) ---
# AI_PROVIDER picks the vendor for BOTH chat replies and search embeddings:
# "openai" (needs OPENAI_API_KEY + billing) or "gemini" (needs
# GEMINI_API_KEY, free tier available). Set AI_ASSISTANT_ENABLED=false to
# run on the deterministic template replies only, with no LLM calls at all.
AI_PROVIDER=openai
AI_ASSISTANT_ENABLED=true
AI_CHAT_MODEL=gpt-4o-mini
AI_MAX_TOKENS=400
AI_TEMPERATURE=0.4
AI_HISTORY_TURNS=20
AI_REQUEST_TIMEOUT_SECONDS=15
AI_RATE_LIMIT_PER_MINUTE=15

# --- Voice transport ---
# Server-backed audio requires a funded OPENAI_API_KEY even when AI_PROVIDER
# is set to gemini for the conversation model. Browser speech remains a
# fallback in the widget when these endpoints are unavailable.
VOICE_ENABLED=true
VOICE_STT_MODEL=gpt-4o-mini-transcribe
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=marin
VOICE_REQUEST_TIMEOUT_SECONDS=30
VOICE_MAX_AUDIO_BYTES=5000000

# --- Conversation engine ---
CONVERSATION_SESSION_TTL_MINUTES=30

# --- CORS ---
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120

# --- Observability ---
LOG_LEVEL=INFO
SENTRY_DSN=
