# Read by docker-compose.yml only (Postgres superuser — creates the
# zello_admin/zello_app roles on first migrate run; see
# db/ddl/003_row_level_security.sql). Every other service's configuration
# lives in its own .env.example (services/api/, apps/dashboard/, apps/admin/)
# — copy each of those too before running `docker compose up`.
POSTGRES_SUPERUSER=zello_superuser
POSTGRES_SUPERUSER_PASSWORD=replace-with-a-long-random-secret-in-any-shared-environment
